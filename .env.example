# otpocket 环境变量（复制为 .env 或写入 compose environment）
# 数据加密与会话签名根密钥（64 位 hex）。不设置则首次启动自动生成到 DATA_DIR/.master_key
# 生成：node -e "console.log([...crypto.getRandomValues(new Uint8Array(32))].map(b=>b.toString(16).padStart(2,'0')).join(''))"
MASTER_KEY=
# 监听端口（默认 8000）
PORT=8000
# 数据目录（默认 ./data；Docker 内为 /data）
DATA_DIR=./data
# 注册模式：open（开放）| invite（邀请码）| closed（关闭）
REGISTER_MODE=open
INVITE_CODE=
# 会话有效期（天）
TOKEN_TTL_DAYS=14
# Cookie Secure 标记（反代提供 HTTPS 时为 1；本地 http 调试设 0）
COOKIE_SECURE=1
